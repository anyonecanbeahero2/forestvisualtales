---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hello, Adventurer!</h1>
			<!-- Slideshow container -->
			<div class="slideshow-container">
				<!-- Full-width images with number and caption text -->
				<div class="mySlides fade">
				<div class="numbertext">1 / 5</div>
				<img src="src/content/images/HaruStroll.png" style="width:100%">
				<div class="text">Haru in her favorite spot</div>
				</div>
				<div class="mySlides fade">
					<div class="numbertext">2 / 5</div>
					<img src="images/carousel/HaruSpirit.png" style="width:100%">
					<div class="text">Haru becomes the Spirit of Koisakubanashi</div>
					</div>
					<div class="mySlides fade">
					<div class="numbertext">3 / 5</div>
					<img src="images/carousel/HaruDonut.png" style="width:100%">
					<div class="text">Haru tries to deal with city life</div>
					</div>
					<div class="mySlides fade">
					<div class="numbertext">4 / 5</div>
					<img src="images/carousel/HaruGlide.png" style="width:100%">
					<div class="text">Haru trying out a technique on a whim</div>
					</div>
					<div class="mySlides fade">
					<div class="numbertext">5 / 5</div>
					<img src="images/carousel/HaruAvenge.png" style="width:100%">
					<div class="text">Haru vows vengeance</div>
					</div>
					<!-- Next and previous buttons -->
					<a class="prev" onclick="plusSlides(-1)">❮</a>
					<a class="next" onclick="plusSlides(1)">❯</a>
				</div>
				<br>
				<!-- The dots/circles -->
				<div style="text-align:center">
				<span class="dot" onclick="showSlide(1)"></span>
				<span class="dot" onclick="showSlide(2)"></span>
				<span class="dot" onclick="showSlide(3)"></span>
				<span class="dot" onclick="showSlide(4)"></span>
				<span class="dot" onclick="showSlide(5)"></span>
			</div>
			<p>
				Welcome to the official site of Forest Visual Tales! Site will show
				you our catalog of stories and where to read them!
			</p>
			<p>
				At present, it's just Haru Hayashi, but there are big plans to expand
				into new series in the future and your support will make that possible,
				so, if you can, please help support Haru's epic journey and future
				publications to come! Donations are highly appreciated, but, just
				sitting down to read her adventure that sometimes becomes extremely
				absurd and dropping a like is a great way to support her too!
			</p>
			<p>fhank you for those who have supported her in the past and a hearty
			welcome to those who join her quest in the future!</p>
		</main>
		<Footer />
	</body>
</html>

<script>
	let slideIndex = 1;
	showSlides();

	// Next/previous controls
	function plusSlides(n) {
	showSlide(slideIndex += n);
	}

	// Thumbnail image controls
	function currentSlide(n) {
	showSlide(slideIndex = n);
	}

	function showSlide(n) {
		let i;
		let slides = document.getElementsByClassName("mySlides");
		let dots = document.getElementsByClassName("dot");
		if (n > slides.length) {slideIndex = 1}
		if (n < 1) {slideIndex = slides.length}
		for (i = 0; i < slides.length; i++) {
			slides[i].style.display = "none";
	}
	for (i = 0; i < dots.length; i++) {
		dots[i].className = dots[i].className.replace(" active", "");
	}
	slides[slideIndex-1].style.display = "block";
	dots[slideIndex-1].className += " active";
	}
	function showSlides() {
		let i;
		let slides = document.getElementsByClassName("mySlides");
		for (i = 0; i < slides.length; i++) {
			slides[i].style.display = "none";
		}
		slideIndex++;
		if (slideIndex > slides.length) {slideIndex = 1}
		slides[slideIndex-1].style.display = "block";
		setTimeout(showSlides, 5000); // Change image every 2 seconds
		}
</script>
